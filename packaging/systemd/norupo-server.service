[Unit]
Description=Norupo tunnel edge server
Documentation=https://github.com/Mahmoud-walid/Norupo-tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/norupo/server.env
ExecStart=/usr/bin/norupo-server
Restart=on-failure
RestartSec=2s

# The edge terminates untrusted traffic, so give it as little as it needs.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Binding 80/443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# One file descriptor per public connection plus one per agent; the default
# 1024 is the first thing to run out under real load.
LimitNOFILE=262144

[Install]
WantedBy=multi-user.target
