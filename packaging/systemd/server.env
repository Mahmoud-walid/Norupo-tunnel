# Norupo edge server configuration.
# Every setting here has a matching --flag; see `norupo-server --help`.

# Base domain that tunnels are published under. Point a wildcard DNS record
# (*.tunnel.example.com) at this host before starting.
NORUPO_BASE_DOMAIN=tunnel.example.com

# Public HTTP ingress. Put a TLS terminator in front, or bind 443 directly.
NORUPO_HTTP_ADDR=0.0.0.0:80

# gRPC control plane that agents connect to.
NORUPO_CONTROL_ADDR=0.0.0.0:7000

# Internal listener used for cross-node hand-off. Must NOT be publicly
# reachable; restrict it to the cluster's private network.
NORUPO_PEER_ADDR=0.0.0.0:7100
# NORUPO_ADVERTISE_ADDR=10.0.3.14:7100

# Agent credentials. Create the file before starting; see the README.
NORUPO_TOKENS_FILE=/etc/norupo/tokens.json

# Shared routing table. Leave unset for a single-node deployment.
# NORUPO_REDIS_URL=redis://127.0.0.1:6379

NORUPO_LOG=info
